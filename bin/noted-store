#!/usr/bin/python3 -I
"""Noted v2: each persisted note has exactly one primary file, no mirrors."""
import datetime
import errno
import fcntl
import json
import os
from pathlib import Path
import stat
import subprocess
import sys
import tempfile
from urllib.parse import unquote, urlparse


class Store:
    def __init__(self, documents=None, state=None, run=subprocess.run, folder=None):
        self.run = run
        if documents is None:
            try:
                result = run(['xdg-user-dir', 'DOCUMENTS'], capture_output=True, text=True)
                documents = result.stdout.strip() if result.returncode == 0 else ''
            except OSError:
                documents = ''
            if not documents or Path(documents) == Path.home():
                documents = str(Path.home() / 'Documents')
        self.documents = self.safe_path(documents)
        self.directory = self.safe_path(os.path.expanduser(str(folder))) if folder else self.documents / 'Noted'
        self.state = self.safe_path(state or Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state'))) / 'noted')
        self.drafts = self.state / 'drafts'
        if self.directory == self.state or self.state in self.directory.parents:
            raise ValueError('internal_destination')
        self.safe_path(self.directory).mkdir(parents=True, exist_ok=True)
        # FileView uses the shell's umask for drafts/recovery; keep their parents private.
        for path in (self.state, self.drafts):
            self.safe_path(path)
            path.mkdir(mode=0o700, parents=True, exist_ok=True)
            path.chmod(0o700)  # Also secure directories from older installations.

    @staticmethod
    def safe_path(raw):
        if not isinstance(raw, (str, Path)) or not str(raw):
            raise ValueError('invalid_path')
        path = Path(raw)
        if not path.is_absolute() or '..' in path.parts:
            raise ValueError('absolute_path')
        for component in [path, *path.parents]:
            if component.is_symlink():
                raise ValueError('no_symlinks')
        path = Path(os.path.normpath(path))
        if path.exists() and not path.is_file() and not path.is_dir():
            raise ValueError('not_regular')
        return path

    def recognized(self, raw, data):
        path = self.safe_path(raw)
        internal = path.parent in (self.directory, self.drafts) and path.suffix == '.md'
        if not internal and str(path) not in data['external']:
            raise ValueError('unknown_note')
        if path.exists() and not path.is_file():
            raise ValueError('not_regular')
        return path

    @staticmethod
    def read(path):
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(fd, 'r', encoding='utf-8') as stream:
            if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
                raise ValueError('not_regular')
            return stream.read(), os.fstat(stream.fileno()).st_mtime

    def descriptor(self, path):
        path = self.safe_path(path)
        text, mtime = self.read(path)
        title = next((line.strip().lstrip('#').strip() for line in text.splitlines() if line.strip()), '')
        return {'id': str(path), 'path': str(path), 'name': path.name, 'title': title or path.name,
                'mtime': mtime, 'associated': path.parent != self.drafts}

    @staticmethod
    def stage(path, text):
        fd, temp = tempfile.mkstemp(prefix='.noted-', dir=path.parent)
        try:
            with os.fdopen(fd, 'w', encoding='utf-8') as stream:
                stream.write(text)
                stream.flush()
                os.fsync(stream.fileno())
            return Path(temp)
        except BaseException:
            os.unlink(temp)
            raise

    @staticmethod
    def sync_directory(path):
        fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)

    def persist(self, data):
        path = self.state / 'catalog.json'
        self.safe_path(path)
        temp = self.stage(path, json.dumps(data, ensure_ascii=False))
        try:
            os.replace(temp, path)
            self.sync_directory(path.parent)
        finally:
            temp.unlink(missing_ok=True)

    def load(self):
        path = self.safe_path(self.state / 'catalog.json')
        if path.exists():
            data = json.loads(path.read_text())
            if data.get('version') != 2 or not isinstance(data.get('external'), list):
                raise ValueError('invalid_catalog')
            return data
        return {'version': 2, 'external': [], 'allocated': [], 'migrated': False}

    def migrate(self, data):
        warnings = []
        if data.get('migrated'):
            return warnings
        legacy = self.safe_path(self.state / 'links.json')
        count = 0
        if legacy.exists():
            old = json.loads(legacy.read_text())
            for link in old.get('links', {}).values():
                try:
                    path = self.safe_path(link['path'])
                    if path.is_file() and path.parent not in (self.directory, self.drafts):
                        if str(path) not in data['external']:
                            data['external'].append(str(path))
                        count += 1
                except (OSError, ValueError, KeyError):
                    continue
            if count:
                warnings.append({'error': 'legacy_preserved', 'args': [count]})
        data['migrated'] = True
        self.persist(data)
        return warnings

    def notes(self, data):
        paths = set(self.directory.glob('*.md')) | set(self.drafts.glob('*.md')) | {Path(p) for p in data['external']}
        notes, warnings = [], []
        for path in sorted(paths):
            try:
                notes.append(self.descriptor(path))
            except FileNotFoundError:
                continue
            except (OSError, ValueError, UnicodeError) as error:
                warnings.append({'id': str(path), **error_payload(error)})
        notes.sort(key=lambda n: (-n['mtime'], n['id']))
        return notes, warnings

    def execute(self, request):
        lockpath = self.safe_path(self.state / 'catalog.lock')
        fd = os.open(lockpath, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, 'a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            return {'ok': True, **self.dispatch(request, self.load())}

    def dispatch(self, req, data):
        op = req['op']
        if op in ('init', 'list'):
            migration_warnings = self.migrate(data) if op == 'init' else []
            notes, warnings = self.notes(data)
            return {'directory': str(self.directory), 'documents': str(self.documents),
                    'notes': notes, 'warnings': migration_warnings + warnings}
        if op == 'allocate':
            base = datetime.datetime.now().strftime('%Y-%m-%d_%H%M%S')
            name, count = base + '.md', 0
            while os.path.lexists(self.drafts / name) or name in data['allocated']:
                count += 1
                name = f'{base}_{count}.md'
            data['allocated'].append(name)
            self.persist(data)
            path = str(self.drafts / name)
            return {'id': path, 'path': path, 'name': name, 'associated': False}
        if op == 'restore':
            path = self.recognized(req['path'], data)
            if os.path.lexists(path):
                raise ValueError('restore_exists')
            listing = self.run(['gio', 'trash', '--list'], capture_output=True, text=True, check=True)
            matches = []
            for line in listing.stdout.splitlines():
                uri, sep, origin = line.partition('\t')
                if origin.startswith('file://'):
                    origin = unquote(urlparse(origin).path)
                if sep and origin == str(path) and uri.startswith('trash:///'):
                    matches.append(uri)
            if len(matches) != 1:
                raise ValueError('restore_ambiguous')
            self.run(['gio', 'trash', '--restore', matches[0]], capture_output=True, text=True, check=True)
            return self.descriptor(path)
        source = self.recognized(req['id'], data)
        if op == 'info':
            return self.descriptor(source)
        if op == 'trash':
            self.run(['gio', 'trash', str(source)], capture_output=True, text=True, check=True)
            return {'id': str(source), 'path': str(source)}
        if op == 'save-as':
            if 'text' in req and not isinstance(req['text'], str):
                raise ValueError('invalid_text')
            target = self.safe_path(req['path'])
            if target.exists() and not target.is_file():
                raise ValueError('not_regular')
            if target.parent == self.drafts or self.state == target or self.state in target.parents:
                raise ValueError('internal_destination')
            if target.parent == self.directory and target.suffix != '.md':
                raise ValueError('markdown_extension')
            if target == source and 'text' not in req:
                return {'note': self.descriptor(source), 'trashed': None}
            text = req['text'] if 'text' in req else self.read(source)[0]
            temp = self.stage(target, text)
            try:
                # Commit metadata BEFORE touching either original file. A failure here
                # leaves both source and any existing destination byte-for-byte intact.
                if target.parent != self.directory and str(target) not in data['external']:
                    data['external'].append(str(target))
                self.persist(data)
                self.safe_path(target)
                os.replace(temp, target)
            finally:
                temp.unlink(missing_ok=True)
            note = {'id': str(target), 'path': str(target), 'name': target.name,
                    'title': next((line.strip().lstrip('#').strip() for line in text.splitlines() if line.strip()), '') or target.name,
                    'mtime': datetime.datetime.now().timestamp(), 'associated': True}
            # Once target is committed, never report a precommit failure to the UI:
            # it must switch its FileView to target even when source trash fails.
            try:
                note = self.descriptor(target)
            except (OSError, ValueError, UnicodeError):
                pass
            try:
                self.sync_directory(target.parent)
            except OSError as error:
                return {'note': note, 'trashed': None, 'warning': 'durability_warning'}
            if target == source or not os.path.lexists(source):
                return {'note': note, 'trashed': None}
            try:
                self.run(['gio', 'trash', str(source)], capture_output=True, text=True, check=True)
                return {'note': note, 'trashed': str(source)}
            except (OSError, subprocess.SubprocessError) as error:
                return {'note': note, 'trashed': None, 'warning': 'original_trash_failed'}
        raise ValueError('operation_failed')


def error_payload(error):
    if isinstance(error, UnicodeError):
        key = 'not_utf8'
    elif isinstance(error, OSError):
        key = {errno.EACCES: 'permission_denied', errno.EPERM: 'permission_denied',
               errno.ENOSPC: 'disk_full', errno.EDQUOT: 'disk_full',
               errno.ENOENT: 'file_missing'}.get(error.errno, 'operation_failed')
    elif isinstance(error, subprocess.SubprocessError):
        key = 'process_failed'
    elif isinstance(error, ValueError) and str(error) in {
        'invalid_path', 'absolute_path', 'no_symlinks', 'not_regular', 'unknown_note',
        'invalid_catalog', 'restore_exists', 'restore_ambiguous', 'invalid_text',
        'internal_destination', 'markdown_extension', 'operation_failed'
    }:
        key = str(error)
    else:
        key = 'operation_failed'
    return {'error': key}


def main():
    try:
        if len(sys.argv) in (3, 4) and sys.argv[1] == 'trash-file':
            req = {'op': 'trash', 'id': sys.argv[2], 'folder': sys.argv[3] if len(sys.argv) == 4 else ''}
        else:
            req = json.load(sys.stdin)
        result = Store(folder=req.get('folder')).execute(req)
    except Exception as error:
        result = {'ok': False, **error_payload(error)}
    print(json.dumps(result, ensure_ascii=False))


if __name__ == '__main__':
    main()
